# Copy to .env and fill in real values (never commit .env with secrets).

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

ADMIN_USER=
# Development: plain password. Production: use ADMIN_PASS_HASH only (bcrypt).
ADMIN_PASS=
# bcrypt hash for production (generate in Python: from passlib.hash import bcrypt; print(bcrypt.hash("your_password")))
ADMIN_PASS_HASH=

# Production: at least 24 characters. Optional strict JWT checks for Hostay-issued tokens:
JWT_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=

HOSTAY_BACKEND_URL=https://api.hostayapp.com

# production | development
ENVIRONMENT=production

# SQLite (Dockerfile sets CHATBOT_DB_PATH=/app/data/hostay_chatbot.db)
# CHATBOT_DB_PATH=/app/data/hostay_chatbot.db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_SSL=1

# HTTPS reverse proxy: set COOKIE_SECURE=1 so admin cookies are Secure
COOKIE_SECURE=0

# Optional: comma-separated extra CORS origins (e.g. staging)
# CORS_EXTRA_ORIGINS=https://staging.example.com

# Optional: restrict Host header (e.g. chat.hostayapp.com,127.0.0.1)
# TRUSTED_HOSTS=chat.hostayapp.com

# Local only: ENABLE_OPENAPI=1 exposes /docs and /openapi.json
# ENABLE_OPENAPI=0

# Tests / CI: skip heavy RAG KB load at startup
# SKIP_RAG_INIT=1
